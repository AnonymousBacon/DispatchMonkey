# Copy to .env and fill in. .env is git-ignored: never commit real keys.
# Sign-up links and free limits: DATA-SOURCES.md

HERE_API_KEY=          # traffic flow + incidents + truck routing   https://platform.here.com
TOMTOM_API_KEY=        # second traffic source                      https://developer.tomtom.com
GOOGLE_MAPS_API_KEY=   # Routes API, traffic-aware ETA (car)        https://console.cloud.google.com
WAQI_TOKEN=            # live air-quality stations                  https://aqicn.org/data-platform/token/
OPENAQ_API_KEY=        # open air-quality sensor network            https://explore.openaq.org/register
