# DispatchMonkey — provider credentials. Copy to .env (gitignored) and fill in.
# Every key is read server-side only (providers.py env()); none is ever sent to
# the browser and none is echoed in an API error.
#
# NOTHING here is required to run the demo. With a variable unset, its endpoint
# returns 503 with a short reason, and the UI falls back to the labelled local
# data for that signal. Missing keys block live verification, not the app.

# --- TomTom ------------------------------------------------------------------
# One key serves both traffic endpoints:
#   GET /api/flow       Traffic Flow Segment v4   (already wired)
#   GET /api/incidents  Orbis Traffic Incident Details v2
# Orbis needs the key to be entitled for "Orbis Maps"; a plain Traffic key gives
# 403 on /api/incidents while /api/flow keeps working.
TOMTOM_KEY=

# --- VIETMAP -----------------------------------------------------------------
# GET /api/route — Route v4, truck + container profiles with real road geometry
# and provider maneuver indexes. https://maps.vietmap.vn/docs/map-api/
VIETMAP_KEY=

# --- AISStream ---------------------------------------------------------------
# GET /api/vessels — live AIS in the Cát Lái box over a server-side WebSocket.
# Free key from https://aisstream.io/. Also needs the python package:
#   pip install websockets
# Without the package the endpoint reports status "no-client" and serves the last
# cached snapshot instead of claiming to be live.
AISSTREAM_KEY=

# --- Vietnamese speech-to-text ----------------------------------------------
# POST /api/transcribe — used for voice posts and voice questions. The driver
# always edits and confirms the transcript before it is posted.
# Google is tried first (vi-VN is first-class there and local place names can be
# boosted); OpenAI is the fallback.
#   Google Cloud Speech-to-Text v1 API key, Speech-to-Text API enabled
GOOGLE_STT_KEY=
#   OpenAI key, model gpt-transcribe
OPENAI_API_KEY=

# --- Not a credential --------------------------------------------------------
# NASA GIBS IMERG precipitation is key-free and called straight from the browser.
# Open-Meteo route weather is key-free and called straight from the browser.
# Sentinel-1 vessel detections are precomputed into static/vn/ships_geo.json.

# Optional: port for server.py (default 8787)
# PORT=8787
